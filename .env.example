# Publieke basis-URL van de site (gebruikt voor sitemap, canonicals en Open Graph)
NEXT_PUBLIC_SITE_URL=https://cleopatraschoonmaak.nl

# Waar het contactformulier naartoe mailt.
# Kies één provider en vul de bijbehorende sleutel in.

# Optie A — Resend (aanbevolen, https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@cleopatraschoonmaak.nl
CONTACT_FROM_EMAIL=website@cleopatraschoonmaak.nl

# Optie B — SMTP (bijv. One.com mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
