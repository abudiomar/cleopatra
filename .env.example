# Publieke basis-URL van de site (gebruikt voor sitemap, canonicals en Open Graph)
NEXT_PUBLIC_SITE_URL=https://cleopatramultiservices.nl

# Het contactformulier wordt door de Cloudflare Worker verstuurd via de
# TransIP-mailserver. Ontvanger, afzender en SMTP-server staan als `vars` in
# wrangler.jsonc; het mailboxwachtwoord is een Cloudflare-secret:
#
#   npx wrangler secret put SMTP_PASSWORD
#
# Lokaal testen met `npm run preview`: zet het wachtwoord in `.dev.vars`
# (staat in .gitignore):
#
#   SMTP_PASSWORD=...
